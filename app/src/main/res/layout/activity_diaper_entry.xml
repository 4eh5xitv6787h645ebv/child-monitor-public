<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tracker_diaper_title"
            android:tag="theme_text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/diaperKindGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="12dp">
            <RadioButton android:id="@+id/kindWet" android:text="@string/tracker_diaper_wet" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <RadioButton android:id="@+id/kindDirty" android:text="@string/tracker_diaper_dirty" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/kindMixed" android:text="@string/tracker_diaper_mixed" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="16dp"
            android:text="@string/tracker_diaper_color"
            android:tag="theme_text_secondary" />

        <RadioGroup
            android:id="@+id/colorGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <RadioButton android:id="@+id/cYellow" android:text="@string/tracker_stool_yellow" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" android:checked="true" />
            <RadioButton android:id="@+id/cTan" android:text="@string/tracker_stool_tan" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/cGreen" android:text="@string/tracker_stool_green" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/cMeconium" android:text="@string/tracker_stool_meconium" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/cBlack" android:text="@string/tracker_stool_black" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/cRed" android:text="@string/tracker_stool_red" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
            <RadioButton android:id="@+id/cPale" android:text="@string/tracker_stool_pale" android:tag="theme_text_primary"
                android:layout_width="wrap_content" android:layout_height="wrap_content" />
        </RadioGroup>

        <TextView
            android:id="@+id/stoolHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:tag="theme_text_secondary"
            android:textSize="12sp" />

        <Button
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:tag="theme_btn_primary"
            android:text="@string/tracker_save" />
    </LinearLayout>
</ScrollView>
