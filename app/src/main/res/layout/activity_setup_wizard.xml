<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <de.rochefort.childmonitor.AnimatedGardenBackgroundView
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingBottom="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="22dp"
            android:paddingBottom="10dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/setupWizardTitle"
                android:textColor="@color/text_primary"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/setupWizardSubtitle"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="theme_card">

                <TextView
                    android:id="@+id/wizardCorePermStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wizardMulticastStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wizardNotificationStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wizardBatteryStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wizardAutoStartStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/wizardRequestCorePermsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_button_primary"
                    android:tag="theme_btn_primary"
                    android:text="@string/requestCorePermissions"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary" />

                <Button
                    android:id="@+id/wizardRequestMulticastButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:tag="theme_btn_secondary"
                    android:text="@string/requestMulticastPermission"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/wizardRequestNotificationButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:tag="theme_btn_secondary"
                    android:text="@string/requestNotificationPermission"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/wizardBatterySettingsButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:tag="theme_btn_secondary"
                    android:text="@string/openBatterySettings"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />

                <Button
                    android:id="@+id/wizardToggleAutoStartButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:tag="theme_btn_secondary"
                    android:text="@string/toggleAutoStart"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_surface_card"
                android:orientation="vertical"
                android:padding="16dp"
                android:tag="theme_card">

                <Button
                    android:id="@+id/wizardOpenChildButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_button_primary"
                    android:tag="theme_btn_primary"
                    android:text="@string/useAsChildDevice"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/wizardOpenParentButton"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_secondary"
                    android:tag="theme_btn_secondary"
                    android:text="@string/useAsParentDevice"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/wizardMarkCompleteButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_button_success"
                    android:tag="theme_btn_accent"
                    android:text="@string/markSetupComplete"
                    android:textAllCaps="false"
                    android:textColor="@color/text_on_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
